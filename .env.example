# Environment Configuration Template

# Database Configuration
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/urban_intelligence_db
SPRING_DATASOURCE_USERNAME=urban_user
SPRING_DATASOURCE_PASSWORD=secure_password_here

# JWT Configuration
JWT_SECRET=urban-intelligence-platform-secure-secret-key-min-256-bits

# Server Configuration
SERVER_PORT=8080

# Spring Profile (dev, prod)
SPRING_PROFILES_ACTIVE=dev

# Logging Level
LOGGING_LEVEL_COM_URBAN=DEBUG
LOGGING_LEVEL_ROOT=INFO

# Application Configuration
APP_ANALYTICS_HOTSPOT_THRESHOLD=5.0
APP_ANALYTICS_CLUSTER_RADIUS=0.05
