# Urban Intelligence Platform - Environment Configuration
# IMPORTANT: Copy this to .env and fill in actual values
# NEVER commit .env to version control
# This file is safe to commit; .env is in .gitignore

# ====== DATABASE CONFIGURATION ======
# PostgreSQL connection details
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/urban_intelligence_db
SPRING_DATASOURCE_USERNAME=urban_user
SPRING_DATASOURCE_PASSWORD=your_secure_password_here_change_in_prod

# ====== JWT CONFIGURATION ======
# Must be at least 256 bits (32 bytes) for HS256
# Generate with: openssl rand -base64 32
JWT_SECRET=change_me_to_strong_secret_at_least_256_bits_long_xxxxxxxx
JWT_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000

# ====== SERVER CONFIGURATION ======
SERVER_PORT=8080
SERVER_SERVLET_CONTEXT_PATH=/

# ====== CORS CONFIGURATION ======
# Comma-separated list of allowed origins
# Production: Use your actual domain
# Dev: localhost:3000, localhost:5173, 127.0.0.1:3000, 127.0.0.1:5173
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# ====== SPRING PROFILE ======
# Options: dev, prod, test
SPRING_PROFILES_ACTIVE=dev

# ====== LOGGING CONFIGURATION ======
LOGGING_LEVEL_COM_URBAN_INTELLIGENCE_PLATFORM=INFO
LOGGING_LEVEL_ORG_SPRINGFRAMEWORK=INFO
LOGGING_LEVEL_ORG_HIBERNATE=WARN
LOGGING_LEVEL_ROOT=INFO

# ====== ANALYTICS CONFIGURATION (Optional) ======
APP_ANALYTICS_HOTSPOT_THRESHOLD=5.0
APP_ANALYTICS_CLUSTER_RADIUS=0.05
